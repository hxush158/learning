# 复制本文件为 .env 后填写：cp .env.example .env
# 整个工程只用这一个 .env（所有示例、MCP Server、docker compose 都读它）

# ---------- 大模型（任意 OpenAI 兼容接口）----------
# 模型需要支持 function calling（第 4 节 ReAct Agent 用到）
# 阿里云百炼 国际站（新西兰可用）: https://dashscope-intl.aliyuncs.com/compatible-mode/v1   模型 qwen-max / qwen-plus
# 阿里云百炼 国内站:               https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:                        https://api.deepseek.com/v1                              模型 deepseek-chat
# OpenAI:                          https://api.openai.com/v1                                模型 gpt-4o-mini
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_CHAT_MODEL=qwen-plus

# ---------- 高德地图 MCP Server ----------
# 申请：https://lbs.amap.com/api/mcp-server/create-project-and-key
AMAP_MAPS_API_KEY=

# ---------- MySQL（docker compose 与 MySQL MCP Server 共用）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mcp_user
MYSQL_PASSWORD=mcp_pass_123
MYSQL_DATABASE=mcp_test
MYSQL_ROOT_PASSWORD=root_pass_123

# ---------- HTTP 类 MCP Server 监听地址 ----------
HOST=127.0.0.1
PORT=8000
